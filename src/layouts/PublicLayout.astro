---
import { ThemeSwitch } from '../components/ThemeSwitch.tsx';

interface Props {
  title?: string;
}

const { title = 'Conexión Barber | Reservá tu turno' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600&family=Oswald:wght@500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      @import '../styles/tokens.css';
    </style>
    <script is:inline>
      (function () {
        var key = 'conexion-theme';
        var theme = 'light';
        try {
          var stored = window.localStorage.getItem(key);
          if (stored === 'light' || stored === 'dark') theme = stored;
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        } catch (e) {
          // ignore
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="topbar container">
      <div class="logo">CONEXIÓN <span>BARBER</span></div>
      <div class="topbar-actions">
        <a class="login-link" href="#">Iniciar sesión</a>
        <ThemeSwitch client:load />
      </div>
    </header>
    <slot />
  </body>
</html>

