---
import PublicLayout from '../../layouts/PublicLayout.astro';
import ServiceCatalog from '../../components/ServiceCatalog.astro';
import { createPublicApiClient, PublicApiError } from '../../lib/public-api.server';
import type { Context, Catalog } from '../../types/public';

export const prerender = false;

const { slug } = Astro.params;
const api = createPublicApiClient();

let context: Context | null = null;
let catalog: Catalog | null = null;

if (typeof slug === 'string') {
  try {
    [context, catalog] = await Promise.all([api.context(slug), api.catalog(slug)]);
  } catch (error) {
    if (error instanceof PublicApiError && error.code === 'PUBLIC_RESOURCE_NOT_FOUND') {
      return Astro.rewrite('/404');
    }
    return new Response('Internal server error', { status: 500 });
  }
} else {
  return Astro.rewrite('/404');
}

function initials(name: string): string {
  const parts = name.trim().split(/\s+/);
  const first = parts[0]?.[0] ?? '';
  const second = parts[1]?.[0] ?? '';
  return (first + second).toUpperCase();
}

const title = context?.barberia.name
  ? `${context.barberia.name} | Reservá tu turno`
  : 'Conexión Barbería | Reservá tu turno';

const profileInfo = {
  address: context.barberia.address ?? 'Av. Gral. Mosconi 3429, C1419, CABA',
  hours: context.barberia.hours ?? 'Hoy 10:00–20:00',
  whatsappUrl: context.barberia.whatsappUrl ?? '#',
  instagramHandle: context.barberia.instagramHandle ?? '@conexion.barber',
  instagramUrl: context.barberia.instagramUrl ?? 'https://instagram.com/conexion.barber',
};
---

<PublicLayout title={title}>
  <>
    <div class="cover-photo">
      <img
        src={`https://picsum.photos/seed/${slug}/900/675`}
        alt={`Foto de portada de ${context.barberia.name}`}
        loading="eager"
      />
    </div>

    <section class="hero container">
      <div class="hero-head">
        <div class="brand-mark" aria-hidden="true">
          <span class="brand-mark-initials">{initials(context.barberia.name)}</span>
        </div>
      </div>
      <p class="eyebrow">Barbería</p>
      <h1 class="hero-title">{context.barberia.name}</h1>
      {context.barberia.description && <p class="tagline">{context.barberia.description}</p>}

      <div class="info-list">
        <div class="info-row">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <span>{profileInfo.address}</span>
        </div>
        <div class="info-row">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <span>{profileInfo.hours}</span>
        </div>
        <div class="info-row">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.5 3.5a10 10 0 0 0-16.9 9.8L2 21l7.9-1.5A10 10 0 1 0 20.5 3.5z"/></svg>
          <a href={profileInfo.whatsappUrl}>Contactanos por WhatsApp</a>
        </div>
        <div class="info-row">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          <a href={profileInfo.instagramUrl}>{profileInfo.instagramHandle}</a>
        </div>
      </div>
    </section>

    <ServiceCatalog services={catalog.services} />
  </>
</PublicLayout>
