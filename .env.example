# Server-only Supabase credentials. Never expose these as NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only barbershop slug resolved by the landing at `/`.
BARBERSHOP_PUBLIC_SLUG=

# Absolute public origin used by metadata. May be omitted in development
# (falls back to http://localhost:3000); required in production.
PUBLIC_SITE_ORIGIN=
